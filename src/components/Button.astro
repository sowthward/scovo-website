---
// primary = Claude Orange, the single main action in a view. Label is bold and 19px (white on orange is 3.1:1, so it must count as large text).
// secondary = blue outline on light grounds, white outline on blue.
interface Props { href?: string; variant?: 'primary' | 'secondary'; type?: 'button' | 'submit'; class?: string; onBlue?: boolean; [k: string]: unknown }
const { href, variant = 'primary', type = 'button', class: cls = '', onBlue = false, ...rest } = Astro.props;
const base = 'inline-flex items-center justify-center gap-2 rounded-lg min-h-12 px-6 py-2.5 font-bold text-[1.1875rem] leading-tight no-underline transition-[filter,background-color] cursor-pointer';
const styles = variant === 'primary'
  ? 'bg-orange text-white hover:brightness-95'
  : onBlue
    ? 'border-2 border-white text-white hover:bg-white/10'
    : 'border-2 border-blue text-blue bg-white hover:bg-sand';
const Tag = href ? 'a' : 'button';
---
<Tag href={href} type={href ? undefined : type} class:list={[base, styles, cls]} {...rest}><slot /></Tag>
