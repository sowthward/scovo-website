---
// Contact card. Initials on a blue circle until a photo is supplied.
import Card from './Card.astro';
import { person } from '../lib/pages';
---
{person && (
  <Card class="flex items-center gap-5">
    {person.photo
      ? <img src={person.photo} alt="" width="80" height="80" class="h-20 w-20 flex-none rounded-full object-cover" />
      : <span class="circle !h-20 !w-20 text-3xl" aria-hidden="true" data-todo="photo">{person.initials}</span>}
    <p>
      <strong class="h3 block">{person.name}</strong>
      <span class="block">{person.role}</span>
      <a class="link inline-block py-1" href={`mailto:${person.email}`}>{person.email}</a>
    </p>
  </Card>
)}
