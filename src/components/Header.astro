---
import Wordmark from './Wordmark.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { site, resolveNav, otherLocaleUrl, locale } from '../lib/pages';
interface Props { pageKey?: string; ctaHref: string; path: string }
const { pageKey, ctaHref, path } = Astro.props;
const nav = resolveNav(site.nav);
const other = otherLocaleUrl(pageKey);
const isCurrent = (h?: string) => h === path;
---
<header class="sticky top-0 z-40 border-b border-grey/50 bg-white" data-header>
  <div class="container-x flex h-16 items-center gap-4 xl:gap-6">
    <a href="/" class="flex flex-col gap-1 text-blue no-underline">
      <Wordmark class="text-[1.625rem]" />
      <span class="text-[0.6875rem] leading-none whitespace-nowrap text-charcoal"><span class="sr-only">, </span>{site.parentTag}</span>
    </a>

    <nav class="ml-4 hidden flex-1 xl:block" aria-label={site.labels.menu}>
      <ul class="flex items-center gap-5 text-[0.9375rem]">
        {nav.map((item) => (
          <li class="relative">
            {item.children ? (
              <details class="group" data-dropdown>
                <summary class="flex items-center gap-1 py-2 hover:text-blue">{item.label}<Icon name="chevron" size={16} class="transition-transform group-open:rotate-180" /></summary>
                <ul class="absolute left-0 top-full z-10 mt-2 w-72 rounded-xl border border-grey/60 bg-white p-2">
                  {item.children.map((c) => <li><a href={c.href} class="block rounded-lg px-3 py-2 no-underline hover:bg-sand">{c.label}</a></li>)}
                </ul>
              </details>
            ) : (
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} class="py-2 no-underline hover:text-blue aria-[current=page]:font-bold aria-[current=page]:text-blue">{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-3 xl:gap-5">
      <p class="flex items-center gap-1.5 text-[0.9375rem]" aria-label={site.labels.language}>
        {(['it', 'en'] as const).map((l, i) => (
          <Fragment>
            {i > 0 && <span aria-hidden="true">/</span>}
            {l === locale
              ? <span class="font-bold text-blue" aria-current="true"><abbr title={site.labels.languageNames[l]} class="no-underline">{l.toUpperCase()}</abbr></span>
              : <a href={other.url} hreflang={l} lang={l} class="inline-flex min-h-6 min-w-6 items-center justify-center no-underline hover:text-blue"><abbr title={site.labels.languageNames[l]} class="no-underline">{l.toUpperCase()}</abbr></a>}
          </Fragment>
        ))}
      </p>
      <div class="hidden sm:block"><Button href={ctaHref} class="!min-h-11 !px-4 !py-2">{site.cta}</Button></div>

      <details class="xl:hidden" data-dropdown data-mobile-menu>
        <summary class="flex h-11 w-11 items-center justify-center rounded-lg border border-charcoal/60" aria-label={site.labels.menu}><Icon name="menu" /></summary>
        <nav class="absolute inset-x-0 top-16 max-h-[calc(100dvh-4rem)] overflow-y-auto border-b border-grey/50 bg-white" aria-label={site.labels.menu}>
          <ul class="container-x py-4">
            {nav.map((item) => item.children ? (
              <li class="border-b border-grey/40 py-3">
                <span class="font-bold">{item.label}</span>
                <ul class="mt-2">{item.children.map((c) => <li><a href={c.href} class="block py-2 pl-4 no-underline">{c.label}</a></li>)}</ul>
              </li>
            ) : (
              <li class="border-b border-grey/40"><a href={item.href} class="block py-3 no-underline">{item.label}</a></li>
            ))}
            <li class="pt-5 pb-2"><Button href={ctaHref} class="w-full">{site.cta}</Button></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Dropdowns are <details>, so they work without JavaScript. This only adds Escape, outside click and close-on-navigate.
  const dropdowns = document.querySelectorAll<HTMLDetailsElement>('[data-dropdown]');
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    dropdowns.forEach((d) => { if (d.open) { d.open = false; d.querySelector('summary')?.focus(); } });
  });
  document.addEventListener('click', (e) => {
    dropdowns.forEach((d) => {
      const t = e.target as Node;
      if (d.open && (!d.contains(t) || (t as HTMLElement).closest?.('a'))) d.open = false;
    });
  });
</script>
