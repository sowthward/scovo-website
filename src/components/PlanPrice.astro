---
// Price of one plan, read from the shared plans file. Never write a price anywhere else.
import Val from './Val.astro';
import { isTbc } from '../lib/tbc';
import type { Plan, PlansContent } from '../content/types';
interface Props { plan: Plan; plans: PlansContent; size?: 'lg' | 'sm' }
const { plan, plans, size = 'lg' } = Astro.props;
const big = size === 'lg' ? 'text-4xl' : 'text-xl';
const amount = (v: unknown) => (isTbc(v) ? v : `${plans.currency} ${v}`);
---
{plan.priceText ? (
  <p class:list={[size === 'lg' ? 'text-2xl' : 'text-base', 'font-bold leading-tight']}>{plan.priceText}</p>
) : (
  <p class="leading-tight">
    <span data-billing="monthly"><span class:list={[big, 'font-bold tabular-nums']}><Val v={amount(plan.price)} /></span></span>
    {plan.priceAnnual !== undefined && <span data-billing="annual" hidden><span class:list={[big, 'font-bold tabular-nums']}><Val v={amount(plan.priceAnnual)} /></span></span>}
    <span class="text-base whitespace-nowrap"> {plans.perMonth} {plans.vat}</span>
  </p>
)}
