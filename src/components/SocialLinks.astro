---
// Social channels from src/data/social.json. Plain links: no embeds and no platform scripts, so no cookies.
import Icon from './Icon.astro';
import { socials } from '../lib/pages';
interface Props { variant?: 'icons' | 'list'; class?: string; label?: string }
const { variant = 'list', class: cls = '', label } = Astro.props;
---
{variant === 'icons' ? (
  <ul class:list={['flex items-center gap-2', cls]} aria-label={label}>
    {socials.map((s) => (
      <li>
        <a href={s.url} target="_blank" rel="noopener" aria-label={s.label} title={s.label}
          class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-white hover:bg-white/10">
          <Icon name={s.icon} />
        </a>
      </li>
    ))}
  </ul>
) : (
  <ul class:list={['space-y-1', cls]} aria-label={label}>
    {socials.map((s) => (
      <li>
        <a href={s.url} target="_blank" rel="noopener" class="link inline-flex min-h-11 items-center gap-2.5">
          <Icon name={s.icon} />{s.label}
        </a>
      </li>
    ))}
  </ul>
)}
