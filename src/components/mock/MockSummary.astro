---
// The Summary page of the dashboard: score, three numbers, first action.
import Frame from './Frame.astro';
import ScoreRing from './ScoreRing.astro';
import ActionTag from './ActionTag.astro';
import { sample } from '../../lib/pages';
const first = sample.actions[0];
---
<Frame title={sample.labels.summary}>
  <ScoreRing />
  <dl class="mt-5 grid gap-3 border-t border-grey/50 pt-4 sm:grid-cols-[auto_1fr_auto]">
    {sample.numbers.map((n) => (
      <div>
        <dt class="text-[0.8125rem]">{n.label}</dt>
        <dd class="text-[0.9375rem] font-bold leading-snug">{n.value}</dd>
      </div>
    ))}
  </dl>
  <div class="mt-4 rounded-lg border-l-4 border-orange bg-sand p-3.5">
    <p class="flex flex-wrap items-center gap-2 text-[0.8125rem] font-bold">{sample.labels.firstAction} <ActionTag tag={first.tag} /></p>
    <p class="mt-1.5 text-[0.9375rem] leading-snug">{first.text}</p>
  </div>
</Frame>
