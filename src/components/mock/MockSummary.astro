---
// The Summary page of the dashboard: score gauge and share-of-voice donut side by side, two numbers, first action.
import Frame from './Frame.astro';
import ScoreGauge from './ScoreGauge.astro';
import ShareDonut from './ShareDonut.astro';
import ActionTag from './ActionTag.astro';
import { sample } from '../../lib/pages';
const first = sample.actions[0];
// Share of voice is in the donut, so it is not repeated in the numbers row.
const numbers = sample.numbers.filter((n) => !n.value.endsWith('%') || n.label !== sample.share.title);
---
<Frame title={sample.labels.summary}>
  <div class="grid items-center gap-5 sm:grid-cols-2">
    <ScoreGauge size="sm" />
    <ShareDonut caption={false} />
  </div>
  <dl class="mt-4 grid gap-3 border-t border-grey/50 pt-4 sm:grid-cols-[auto_1fr]">
    {numbers.map((n) => (
      <div>
        <dt class="text-[0.8125rem]">{n.label}</dt>
        <dd class="text-[0.9375rem] font-bold leading-snug">{n.value}</dd>
      </div>
    ))}
  </dl>
  <div class="mt-4 rounded-lg border-l-4 border-orange bg-sand p-3.5">
    <p class="flex flex-wrap items-center gap-2 text-[0.8125rem] font-bold">{sample.labels.firstAction} <ActionTag tag={first.tag} /></p>
    <p class="mt-1.5 text-[0.9375rem] leading-snug">{first.text}</p>
  </div>
</Frame>
