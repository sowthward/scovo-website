---
import Layout from '../components/Layout.astro';
import Button from '../components/Button.astro';
import { site } from '../lib/pages';
const nf = site.notFound;
const page = { key: '404', slug: '404', published: false, navLabel: nf.title, meta: { title: `${nf.title} | SCOVO`, description: nf.text } };
---
<Layout page={page} form={false}>
  <section class="on-blue bg-blue text-white">
    <div class="container-x py-20 lg:py-32">
      <p class="text-7xl font-bold leading-none">404</p>
      <h1 class="h1 mt-4">{nf.title}</h1>
      <p class="lead mt-5">{nf.text}</p>
      <div class="mt-8"><Button href="/">{nf.back}</Button></div>
    </div>
  </section>
</Layout>
