---
import Layout from '../components/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import Todo from '../components/Todo.astro';
import ContactCard from '../components/ContactCard.astro';
import { href, isPublished } from '../lib/pages';
const { page } = Astro.props;
---
<Layout page={page}>
  <PageHero title={page.h1} lead={page.lead} crumb={page.navLabel} />

  <Section>
    <div class="grid gap-12 lg:grid-cols-2">
      {page.blocks.map((b: any) => (
        <div>
          <h2 class="h2 text-blue">{b.title}</h2>
          {b.text.map((p: string, i: number) => <p class:list={[i === 0 ? 'lead mt-5' : 'mt-3']}>{p}</p>)}
          {b.todo && <div class="mt-4"><Todo text={b.todo} /></div>}
          {b.link && <p class="mt-4"><a class="link inline-flex items-center gap-1.5 py-1 font-bold" href={b.link.href} rel="noopener">{b.link.label}<Icon name="arrow" size={18} /></a></p>}
        </div>
      ))}
    </div>
  </Section>

  <Section bg="sand" title={page.principles.title} lead={page.principles.lead}>
    <ul class="grid gap-6 lg:grid-cols-3">
      {page.principles.items.map((p: any) => (
        <Card as="li">
          <span class="circle"><Icon name={p.icon} /></span>
          <h3 class="h3 mt-4">{p.title}</h3>
          <p class="mt-2">{p.text}</p>
        </Card>
      ))}
    </ul>
    {isPublished('measure') && <p class="mt-8"><a class="inline-flex items-center gap-1.5 py-1 text-[1.1875rem] font-bold text-blue underline" href={href('measure')}>{page.principles.link}<Icon name="arrow" size={18} /></a></p>}
  </Section>

  <Section title={page.contact.title} lead={page.contact.lead}>
    <div class="max-w-xl"><ContactCard /></div>
  </Section>
</Layout>
