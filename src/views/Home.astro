---
import Layout from '../components/Layout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Testimonials from '../components/Testimonials.astro';
import MockSummary from '../components/mock/MockSummary.astro';
import MockScore from '../components/mock/MockScore.astro';
import MockActions from '../components/mock/MockActions.astro';
import ActionTag from '../components/mock/ActionTag.astro';
import { href, isPublished, sample, site } from '../lib/pages';

const { page } = Astro.props;
const { hero, intro, product, actions, features, whoFor, compare, numbers } = page;
const linkTo = (to: { page?: string; anchor?: string }) => (to.page ? (isPublished(to.page) ? href(to.page) : undefined) : to.anchor);
const exampleFor = (tag: string) => sample.actions.find((a) => a.tag === tag)?.text;
---
<Layout page={page}>
  {/* 2. Hero */}
  <section class="on-blue bg-blue text-white">
    <div class="container-x grid items-center gap-10 py-14 lg:grid-cols-[1.1fr_1fr] lg:gap-16 lg:py-24">
      <div>
        <h1 class="h1">{hero.h1}</h1>
        <p class="lead mt-6 max-w-xl">{hero.sub}</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
          <Button href="#prova">{hero.cta}</Button>
          <a href="#esempio" class="link inline-flex min-h-12 items-center gap-2 font-bold">{hero.exampleLink}<Icon name="arrow" size={20} class="rotate-90" /></a>
        </div>
      </div>
      <MockSummary />
    </div>
  </section>

  {/* 3. Intro */}
  <section class="section-y bg-white">
    <div class="container-x">
      <div class="mx-auto max-w-3xl">
        <h2 class="h2 text-center text-blue">{intro.title}</h2>
        <p class="lead mt-6">{intro.text}</p>
      </div>
    </div>
  </section>

  {/* 4. Two product cards */}
  <Section bg="sand" id="cosa-fa" title={product.title} lead={product.lead}>
    <div id="esempio" class="grid gap-6 lg:grid-cols-2">
      {product.cards.map((c: any) => (
        <Card class="flex flex-col">
          <h3 class="h3">{c.title}</h3>
          <p class="mt-2">{c.text}</p>
          {linkTo(c.to) && <p class="mt-3"><a class="link inline-flex items-center gap-1.5 py-1 font-bold" href={linkTo(c.to)}>{c.link}<Icon name="arrow" size={18} /></a></p>}
          <div class="mt-6">{c.mock === 'score' ? <MockScore /> : <MockActions />}</div>
        </Card>
      ))}
    </div>
  </Section>

  {/* 5. Three kinds of action */}
  <Section id="come-funziona" title={actions.title} lead={actions.lead}>
    <ol class="grid gap-6 lg:grid-cols-3">
      {actions.cards.map((c: any, i: number) => (
        <Card as="li" class="flex flex-col">
          <span class="circle" aria-hidden="true">{i + 1}</span>
          <h3 class="h3 mt-4">{c.title}</h3>
          <p class="mt-2">{c.text}</p>
          {c.note && <p class="mt-3 border-l-4 border-orange pl-3 font-bold">{c.note}</p>}
          <div class="mt-auto pt-6">
            <div class="rounded-lg bg-sand p-4">
              <p class="flex flex-wrap items-center gap-2 text-[0.8125rem] font-bold">{actions.exampleLabel} <ActionTag tag={c.tag} /></p>
              <p class="mt-2 text-base leading-snug">{exampleFor(c.tag)}</p>
            </div>
          </div>
        </Card>
      ))}
    </ol>
    <p class="small mt-4">{sample.disclaimer}</p>
  </Section>

  {/* 6. Tabbed feature grids. Both panels are in the HTML; the script only turns them into tabs. */}
  <Section bg="sand" title={features.title} lead={features.lead}>
    <div data-tabs>
      <div role="tablist" aria-label={features.title} class="mb-10 hidden w-fit rounded-full border border-charcoal/60 bg-white p-1" data-tablist>
        {features.tabs.map((t: any, i: number) => (
          <button type="button" role="tab" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
            class="min-h-11 cursor-pointer rounded-full px-5 font-bold aria-selected:bg-blue aria-selected:text-white">{t.label}</button>
        ))}
      </div>
      {features.tabs.map((t: any, i: number) => (
        <div id={`panel-${i}`} role="tabpanel" aria-labelledby={`tab-${i}`} tabindex="0" class:list={[i > 0 && 'mt-14']} data-panel>
          <h3 class="h3 mb-6" data-panel-title>{t.label}</h3>
          <ul class:list={['grid gap-6 sm:grid-cols-2', t.items.length === 5 ? 'lg:grid-cols-5' : 'lg:grid-cols-4']}>
            {t.items.map((item: any) => (
              <li class="card !p-5">
                <span class="circle"><Icon name={item.icon} /></span>
                <h4 class="mt-4 text-[1.0625rem] leading-snug font-bold">{item.title}</h4>
                <p class="mt-1.5 text-base leading-snug">{item.text}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    {isPublished('features') && <p class="mt-8"><a class="link-strong inline-flex items-center gap-1.5 py-1 text-[1.1875rem] font-bold text-blue underline" href={href('features')}>{features.featuresLink}<Icon name="arrow" size={18} /></a></p>}
  </Section>

  {/* 7. Per chi è: who SCOVO is for, then the sector cards. A card links to its sector page only when that page is published. */}
  <Section id={whoFor.id} title={whoFor.title} lead={whoFor.intro}>
    <h3 class="h3">{whoFor.fitTitle}</h3>
    <ul class="mt-5 grid gap-x-6 gap-y-5 sm:grid-cols-2 lg:grid-cols-4">
      {whoFor.fit.map((p: any) => (
        <li class="flex items-start gap-3">
          <span class="circle !h-11 !w-11"><Icon name={p.icon} size={22} /></span>
          <span class="pt-2 font-bold leading-snug">{p.text}</span>
        </li>
      ))}
    </ul>

    <h3 class="sr-only">{whoFor.sectorsTitle}</h3>
    <ul class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {whoFor.cards.map((c: any) => (
        <Card as="li" class="flex flex-col">
          <span class="circle"><Icon name={c.icon} /></span>
          <h4 class="h3 mt-4">{c.title}</h4>
          <div class="mt-4 rounded-lg bg-sand p-4">
            <p class="text-[0.8125rem] font-bold">{whoFor.questionLabel}</p>
            <p class="mt-1 leading-snug">{site.labels.quotes[0]}{c.question}{site.labels.quotes[1]}</p>
          </div>
          <p class="mt-4 text-base leading-snug">{c.angle}</p>
          {isPublished(c.page) && <p class="mt-auto pt-5"><a class="link inline-flex items-center gap-1.5 py-1 font-bold" href={href(c.page)}>{whoFor.link}<span class="sr-only">: {c.title}</span><Icon name="arrow" size={18} /></a></p>}
        </Card>
      ))}
      <Card as="li" class="flex flex-col !border-dashed !border-charcoal/50 !bg-sand">
        <span class="circle !bg-white !text-blue ring-1 ring-blue"><Icon name="question" /></span>
        <h4 class="h3 mt-4">{whoFor.other.title}</h4>
        <p class="mt-2 text-base leading-snug">{whoFor.other.text}</p>
        <p class="mt-auto pt-5"><a class="inline-flex items-center gap-1.5 py-1 font-bold text-blue underline underline-offset-[0.2em]" href="#prova">{whoFor.other.link}<Icon name="arrow" size={18} class="rotate-90" /></a></p>
      </Card>
    </ul>
  </Section>

  {/* 8. Without / with */}
  <Section bg="sand" title={compare.title} lead={compare.lead}>
    <div class="grid gap-6 lg:grid-cols-2">
      <Card>
        <h3 class="h3 flex items-center gap-3"><Icon name="cross" />{compare.without.title}</h3>
        <ul class="mt-5 space-y-3.5">
          {compare.without.items.map((t: string) => <li class="flex gap-3"><Icon name="cross" size={22} class="mt-0.5 flex-none" /><span>{t}</span></li>)}
        </ul>
      </Card>
      <Card class="!border-2 !border-blue">
        <h3 class="h3 flex items-center gap-3 text-blue"><Icon name="check" />{compare.with.title}</h3>
        <ul class="mt-5 space-y-3.5">
          {compare.with.items.map((t: string) => <li class="flex gap-3"><Icon name="check" size={22} class="mt-0.5 flex-none text-blue" /><span>{t}</span></li>)}
        </ul>
      </Card>
    </div>
  </Section>

  {/* 9. Counter band. The real numbers are in the HTML; the count-up is an enhancement. */}
  <section class="on-blue bg-blue py-14 text-white lg:py-20" aria-labelledby="numeri-title">
    <div class="container-x">
      <h2 id="numeri-title" class="sr-only">{numbers.title}</h2>
      <dl class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {numbers.items.map((n: any) => (
          <div class="flex flex-col">
            <dt class="order-2 mt-2 text-[1.1875rem] font-bold leading-snug">{n.label}</dt>
            <dd class="order-1 text-6xl font-bold leading-none tabular-nums lg:text-7xl" data-count={n.value}>{n.value}</dd>
            <dd class="order-3 mt-2 text-base">{n.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* 10. Testimonials: built, switched off while the list is empty. 11. Logo strip: left out. */}
  <Testimonials />
</Layout>

<script>
  // Tabs
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const list = root.querySelector<HTMLElement>('[data-tablist]')!;
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    list.classList.remove('hidden');
    list.classList.add('flex');
    root.querySelectorAll('[data-panel-title]').forEach((t) => t.classList.add('sr-only'));
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      panels.forEach((p, j) => { p.hidden = i !== j; p.classList.remove('mt-14'); });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') select((i + 1) % tabs.length, true);
        if (e.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length, true);
      });
    });
    select(0);
  });

  // Count-up, off when the visitor prefers reduced motion.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        io.unobserve(el);
        const end = Number(el.dataset.count);
        const start = performance.now();
        const tick = (now: number) => {
          const p = Math.min(1, (now - start) / 900);
          el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.6 });
    document.querySelectorAll('[data-count]').forEach((el) => io.observe(el));
  }
</script>
