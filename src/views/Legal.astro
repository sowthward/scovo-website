---
// Privacy and Cookie: layout and headings only. No legal text is written here.
import Layout from '../components/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Todo from '../components/Todo.astro';
const { page } = Astro.props;
---
<Layout page={page} form={false}>
  <PageHero title={page.h1} crumb={page.navLabel} />
  <section class="section-y bg-white">
    <div class="container-x">
      <div class="max-w-3xl space-y-10">
        {page.todoNote && <Todo text={page.todoNote} />}
        {page.sections.map((s: any) => (
          <div>
            <h2 class="h3 text-blue">{s.title}</h2>
            {s.text && s.text.map((p: string) => <p class="mt-3">{p}</p>)}
            {s.todo && <div class="mt-3"><Todo text={s.todo} /></div>}
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
