---
import Layout from '../components/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import Val from '../components/Val.astro';
import PlanPrice from '../components/PlanPrice.astro';
import PlanButton from '../components/PlanButton.astro';
import { hasAnnual } from '../lib/plans';
import { isTbc } from '../lib/tbc';
import { href, isPublished } from '../lib/pages';
import type { PlansContent } from '../content/types';

const { page } = Astro.props;
const plans: PlansContent = page.plans;
const list = plans.plans;
const trial = plans.trialOffer;
const annual = hasAnnual(plans);
const answered = page.faq.items.filter((f: any) => !isTbc(f.a));
const faq = { '@type': 'FAQPage', mainEntity: answered.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const cols = { 1: 'lg:grid-cols-1', 2: 'lg:grid-cols-2', 3: 'lg:grid-cols-3', 4: 'lg:grid-cols-4', 5: 'lg:grid-cols-5' }[list.length] ?? 'lg:grid-cols-4';
---
<Layout page={page} jsonLd={[faq]}>
  <PageHero title={page.h1} lead={page.lead} crumb={page.navLabel} />

  <section class="section-y bg-sand" data-pricing>
    <div class="container-x">
      <h2 class="sr-only">{page.cardsTitle}</h2>

      {/* Billing switch: rendered only if at least one plan has an annual price. */}
      {annual && (
        <fieldset class="mb-8 flex w-fit items-center gap-1 rounded-full border border-charcoal/60 bg-white p-1" data-billing-switch>
          <legend class="sr-only">{plans.billing.label}</legend>
          {(['monthly', 'annual'] as const).map((b, i) => (
            <label class="flex min-h-11 cursor-pointer items-center rounded-full px-5 font-bold has-checked:bg-blue has-checked:text-white has-focus-visible:outline-3">
              <input type="radio" name="billing" value={b} checked={i === 0} class="sr-only" />{plans.billing[b]}
            </label>
          ))}
        </fieldset>
      )}

      <ul class:list={['grid gap-6 md:grid-cols-2', cols]}>
        {list.map((plan) => (
          <li class:list={['card flex flex-col', plan.trial ? 'on-blue !border-blue !bg-blue text-white' : '', plan.popular && '!border-2 !border-blue']}>
            {plan.popular && <p class="mb-3 w-fit rounded-full bg-blue px-3 py-0.5 text-[0.8125rem] font-bold text-white">{plans.popularLabel}</p>}
            <h3 class="h3">{plan.name}</h3>
            <div class="mt-3 min-h-14"><PlanPrice plan={plan} plans={plans} /></div>
            <p class="mt-2 min-h-12"><Val v={plan.forWhom} /></p>
            <div class="mt-4"><PlanButton plan={plan} class="w-full" /></div>
            <p class="mt-6 text-[0.8125rem] font-bold">{page.includesLabel}</p>
            <ul class="mt-2 space-y-2 text-base">
              {plan.includes.map((item) => (
                <li class="flex gap-2"><Icon name="check" size={20} class="mt-0.5 flex-none" /><span><Val v={item} /></span></li>
              ))}
            </ul>
          </li>
        ))}
      </ul>

      {/* The 14-day trial: an entry offer shown on this page only, not a plan. */}
      <div id={trial.id} class="card on-blue mt-8 !border-blue !bg-blue text-white">
        <h3 class="h3">{trial.title}</h3>
        <ul class="mt-3 flex flex-wrap gap-x-2 gap-y-1">
          {trial.items.map((item, i) => <li>{i > 0 && <span aria-hidden="true">· </span>}{item}</li>)}
        </ul>
        <p class="mt-3">{trial.planLabel} <Val v={trial.plan} /></p>
      </div>
    </div>
  </section>

  {/* "Cosa include ogni piano": a real table on wide screens, one block per plan on phones. */}
  <Section title={plans.includesTable.title} lead={plans.includesTable.lead}>
    <div class="card hidden overflow-hidden !p-0 md:block">
      <table class="w-full table-fixed text-left text-base">
        <thead>
          <tr class="border-b border-grey/60 bg-sand">
            <td class="w-[26%] px-5 py-4"></td>
            {list.map((p) => <th scope="col" class="px-4 py-4 font-bold">{p.name}</th>)}
          </tr>
        </thead>
        <tbody>
          {plans.includesTable.rows.map((row) => (
            <tr class="border-b border-grey/40 last:border-0">
              <th scope="row" class="px-5 py-3.5 font-bold">{row.label}</th>
              {list.map((p) => <td class="px-4 py-3.5"><Val v={row.cells[p.key]} /></td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="space-y-6 md:hidden">
      {list.map((p) => (
        <div class="card">
          <h3 class="h3">{p.name}</h3>
          <dl class="mt-3">
            {plans.includesTable.rows.map((row) => (
              <div class="flex items-baseline justify-between gap-4 border-b border-grey/40 py-2.5 last:border-0">
                <dt>{row.label}</dt>
                <dd class="text-right font-bold"><Val v={row.cells[p.key]} /></dd>
              </div>
            ))}
          </dl>
        </div>
      ))}
    </div>
    {isPublished('features') && <p class="mt-8"><a class="link inline-flex items-center gap-1.5 py-1 font-bold" href={href('features')}>{page.featuresLink}<Icon name="arrow" size={18} /></a></p>}
  </Section>

  <Section bg="sand" title={page.faq.title}>
    <dl class="max-w-3xl space-y-4">
      {page.faq.items.map((f: any) => (
        <div class="card !p-5">
          <dt class="font-bold">{f.q}</dt>
          <dd class="mt-1.5"><Val v={f.a} /></dd>
        </div>
      ))}
    </dl>
  </Section>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('[data-billing-switch]').forEach((sw) => {
    sw.addEventListener('change', (e) => {
      const value = (e.target as HTMLInputElement).value;
      document.querySelectorAll<HTMLElement>('[data-billing]').forEach((el) => {
        // Plans without an annual price keep showing the monthly one.
        const hasAnnual = el.parentElement!.querySelector('[data-billing="annual"]');
        el.hidden = hasAnnual ? el.dataset.billing !== value : false;
      });
    });
  });
</script>
